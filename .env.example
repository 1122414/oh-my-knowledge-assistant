# OMKA 环境变量配置
# 复制此文件为 .env 并填入实际值

# ===========================================
# GitHub API 配置
# ===========================================
GITHUB_TOKEN=your_github_token_here
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28

# ===========================================
# LLM 模型配置
# ===========================================
# 支持: openai, qwen, ollama
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=30

# Ollama 本地模型配置（如果使用 ollama）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ===========================================
# 应用配置
# ===========================================
APP_NAME=OMKA
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ===========================================
# 数据库配置
# ===========================================
DATABASE_URL=sqlite:///data/db/app.sqlite
DATABASE_ECHO=false

# ===========================================
# 调度器配置
# ===========================================
# 每日抓取 Cron 表达式（默认每天早上 9:00）
SCHEDULER_DAILY_CRON=0 9 * * *
SCHEDULER_TIMEZONE=Asia/Shanghai

# ===========================================
# 数据采集配置
# ===========================================
# GitHub API 请求全局并发数
FETCH_CONCURRENCY=3
# 单次请求超时时间（秒）
FETCH_TIMEOUT=30
# 失败重试次数
FETCH_MAX_RETRIES=3
# 重试间隔基数（秒，指数退避）
FETCH_RETRY_BASE_DELAY=2

# Search API 限速（请求/分钟）
SEARCH_RATE_LIMIT=10

# 每日关键词搜索每个查询返回数量
SEARCH_RESULTS_PER_QUERY=5
# 每个仓库获取最新 Release 数量
RELEASES_PER_REPO=1

# ===========================================
# 个性化排序配置
# ===========================================
# 打分权重
SCORE_WEIGHT_INTEREST=0.40
SCORE_WEIGHT_PROJECT=0.30
SCORE_WEIGHT_FRESHNESS=0.15
SCORE_WEIGHT_POPULARITY=0.15

# 新鲜度衰减天数（超过此天数分数降低）
FRESHNESS_DECAY_DAYS=7

# 每日简报 Top N 条目数
DIGEST_TOP_N=10

# ===========================================
# 知识库配置
# ===========================================
# 数据目录根路径
DATA_DIR=data
# 用户画像配置路径
PROFILES_DIR=data/profiles
# 原始数据保存路径
RAW_DATA_DIR=data/raw
# 每日简报输出路径
DIGESTS_DIR=data/digests
# 知识库保存路径
KNOWLEDGE_DIR=data/knowledge

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
